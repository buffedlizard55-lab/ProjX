{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buffedlizard55-lab.github.io/ProjX/data/schema.json",
  "title": "ProjX catalog schema",
  "type": "object",
  "required": ["metadata", "entries", "irregularities"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["title", "generatedAt", "entryCount"],
      "properties": {
        "title": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date" },
        "entryCount": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string" }
      },
      "additionalProperties": true
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "categories",
          "legalAdultEvidence",
          "sources",
          "verificationStatus",
          "lastReviewed",
          "flags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable unique identifier for the record."
          },
          "displayName": {
            "type": "string",
            "description": "Public/professional display name."
          },
          "categories": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Professional categories such as model, fitness, athlete, fashion, lifestyle, creator, entertainment, public personality — objective, never hot/sexy ranking; women-only."
          },
          "legalAdultEvidence": {
            "type": "object",
            "required": ["summary", "sourceLabel", "sourceUrl", "checkedAt"],
            "properties": {
              "summary": {
                "type": "string",
                "description": "Human-readable age/18+ verification summary."
              },
              "sourceLabel": { "type": "string" },
              "sourceUrl": { "type": "string", "format": "uri" },
              "checkedAt": { "type": "string", "format": "date" }
            },
            "additionalProperties": false
          },
          "genderEvidence": {
            "type": "object",
            "required": ["summary", "sourceLabel", "sourceUrl", "checkedAt"],
            "properties": {
              "summary": {
                "type": "string",
                "description": "Human-readable gender verification summary — evidence that the subject is a woman from a reliable public source (first-party bio, official site, agency, sports org, reputable interview); never from appearance/clothing/name/AI."
              },
              "sourceLabel": { "type": "string" },
              "sourceUrl": { "type": "string", "format": "uri" },
              "checkedAt": { "type": "string", "format": "date" }
            },
            "additionalProperties": false
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["label", "platform", "url", "relationship"],
              "properties": {
                "label": { "type": "string" },
                "platform": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "relationship": {
                  "type": "string",
                  "enum": ["official", "verified-platform", "agency", "press", "age-evidence", "other-trusted"]
                }
              },
              "additionalProperties": false
            }
          },
          "verificationStatus": {
            "type": "string",
            "enum": ["verified", "needs-review", "blocked"]
          },
          "lastReviewed": { "type": "string", "format": "date" },
          "flags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Unresolved issues. Verified records should normally have an empty flags array."
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "irregularities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "summary", "reviewStatus"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["needs-review", "blocked", "resolved"] },
          "summary": { "type": "string" },
          "detail": { "type": "string" },
          "reviewStatus": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "reviewQueue": {
      "type": "array",
      "description": "Promising public creators discovered via activity-first research where one or more verification fields still need stronger evidence — not discarded, flagged for further research. Separate from VERIFIED entries.",
      "items": {
        "type": "object",
        "required": ["id", "displayName", "platform", "profileUrl", "discoveryCategory", "missingEvidence", "flags", "lastChecked"],
        "properties": {
          "id": { "type": "string", "description": "Stable candidate ID, e.g., R-2026-001" },
          "displayName": { "type": "string", "description": "Public display name or handle if real name not public" },
          "handle": { "type": "string", "description": "Public username/handle, e.g., @fitgirl_08" },
          "platform": { "type": "string", "description": "Primary discovery platform, e.g., Instagram, TikTok, YouTube" },
          "profileUrl": { "type": "string", "format": "uri", "description": "Public profile URL" },
          "discoveryCategory": {
            "type": "string",
            "description": "Objective activity category that caused discovery, e.g., Fitness, Swimwear, College Athlete"
          },
          "evidenceFound": {
            "type": "object",
            "description": "Strongest legitimate public evidence actually found so far",
            "properties": {
              "summary": { "type": "string" },
              "sourceLabel": { "type": "string" },
              "sourceUrl": { "type": "string", "format": "uri" }
            },
            "additionalProperties": false
          },
          "missingEvidence": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Exact missing verification fields, e.g., AGE_UNVERIFIED, GENDER_UNVERIFIED, PROFILE_UNVERIFIED, IDENTITY_UNCERTAIN"
          },
          "flags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "lastChecked": { "type": "string", "format": "date" },
          "notes": { "type": "string", "description": "Reason for REVIEW_REQUIRED, what was checked, what remains" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
